; ANSI terminal helpers for the first Triptych serial profile.
; These are ordinary Scheme definitions. The runtime emits the strings through
; its existing console path, so another terminal or harness can interpret the
; same byte stream without a Z80-specific primitive.

(define (terminal-write text)
  (display text))

(define (terminal-line text)
  (begin
    (display text)
    (newline)))

(define (terminal-clear)
  (display "\x1b;[2J"))

(define (terminal-home)
  (display "\x1b;[H"))

(define (terminal-reset)
  (display "\x1b;[0m"))

(define (terminal-bold)
  (display "\x1b;[1m"))

(define (terminal-underline)
  (display "\x1b;[4m"))

(define (terminal-reverse)
  (display "\x1b;[7m"))

(define (terminal-red)
  (display "\x1b;[31m"))

(define (terminal-green)
  (display "\x1b;[32m"))

(define (terminal-blue)
  (display "\x1b;[34m"))

(define (terminal-cursor-up)
  (display "\x1b;[A"))

(define (terminal-cursor-down)
  (display "\x1b;[B"))

(define (terminal-cursor-right)
  (display "\x1b;[C"))

(define (terminal-cursor-left)
  (display "\x1b;[D"))

(define (terminal-erase-line)
  (display "\x1b;[2K"))
