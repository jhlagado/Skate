; Standard higher-order and conversion procedures, written in Skate.
;
; Include this file with (include "STDLIB.SK8") before the program's own
; forms.  Procedures such as length, append, reverse, memq, assoc, equal?,
; map, for-each, list-copy and the list, vector and string conversions are
; built into the runtime.
;
; Loops are iterative so that long lists do not exhaust the native stack:
; results are built in reverse and then reversed once.

; The elements of a list for which the predicate is true, in order.
(define (filter keep? items)
  (let loop ((items items) (result '()))
    (cond ((null? items) (reverse result))
          ((keep? (car items)) (loop (cdr items) (cons (car items) result)))
          (else (loop (cdr items) result)))))

; (fold-left f init list): (f (f (f init x1) x2) x3).
(define (fold-left f result items)
  (if (null? items)
      result
      (fold-left f (f result (car items)) (cdr items))))

; (fold-right f init list): (f x1 (f x2 (f x3 init))).
(define (fold-right f result items)
  (fold-left (lambda (acc x) (f x acc)) result (reverse items)))

; (reduce f default list) folds a non-empty list from its first element.
(define (reduce f default items)
  (if (null? items)
      default
      (fold-left f (car items) (cdr items))))

(define (last-pair items)
  (if (pair? (cdr items)) (last-pair (cdr items)) items))

; (iota count) or (iota count start): count integers from start, default 0.
(define (iota count . start)
  (let loop ((n (- count 1))
             (base (if (null? start) 0 (car start)))
             (result '()))
    (if (< n 0)
        result
        (loop (- n 1) base (cons (+ base n) result)))))
