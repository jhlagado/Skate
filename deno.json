    "test:cpm:data": "deno run --config deno.runtime.json --allow-read=.,../atom,../debug80-runtime,../z80-tool-services,../triptych --allow-write=build tools/compiler-checks/procedure-cpm-proof.mjs --data",
    "test:cpm:integers": "deno run --config deno.runtime.json --allow-read=.,../atom,../debug80-runtime,../z80-tool-services,../triptych --allow-write=build tools/compiler-checks/procedure-cpm-proof.mjs --integers",
    "test:cpm:edge": "deno run --config deno.runtime.json --allow-read=.,../atom,../debug80-runtime,../z80-tool-services,../triptych tools/compiler-checks/scope-control-edge-cpm-proof.mjs",
    "test:cpm:console": "deno run --config deno.runtime.json --allow-read=.,../atom,../debug80-runtime,../z80-tool-services,../triptych tools/compiler-checks/scope-control-console-cpm-proof.mjs",
    "test:cpm:release": "deno run --config deno.runtime.json --allow-read=.,../atom,../debug80-runtime,../z80-tool-services,../triptych --allow-write=build tools/compiler-checks/release-cpm-proof.mjs",
    "measure": "deno run --config deno.runtime.json --allow-read=.,../atom,../debug80-runtime,../z80-tool-services tools/compiler-checks/scope-control-budget.ts",
