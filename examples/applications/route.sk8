; Find a path through a small adventure map using depth-first search.
; Each entry contains a room number followed by its exit destinations.
; 1 gate, 2 hall, 3 kitchen, 4 cellar, 5 tower, 6 vault.
(define world (quote ((1 2) (2 1 3 5)
                     (3 2 4) (4 3)
                     (5 2 6) (6 5))))
(define contains
  (lambda (value items)
    (if (null? items) #f
        (if (eq? value (car items)) #t (contains value (cdr items))))))
(define exits
  (lambda (room rooms)
    (if (null? rooms) (quote ())
        (if (eq? room (car (car rooms))) (cdr (car rooms))
            (exits room (cdr rooms))))))
(define search-exits
  (lambda (rooms goal visited)
    (if (null? rooms) #f
        (or (find-path (car rooms) goal visited)
            (search-exits (cdr rooms) goal visited)))))
(define find-path
  (lambda (room goal visited)
    (if (contains room visited) #f
        (if (eq? room goal) (list room)
            (let ((path (search-exits (exits room world) goal
                                     (cons room visited))))
              (if path (cons room path) #f))))))
(display "Route: 1=gate, 2=hall, 3=kitchen, 4=cellar, 5=tower, 6=vault:") (newline)
(write (find-path 1 6 (quote ()))) (newline)
