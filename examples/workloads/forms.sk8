; Derived forms: when, unless, case and n-ary and/or, including tail calls
; through each of them.
(when #t (display "a") (display "b"))
(when #f (display "X"))
(unless #f (display "c"))
(unless #t (display "Y"))
(newline)
(write (list (when #t 1 2) (unless #f 3)))
(newline)
(define (kind x)
  (case x
    ((1 2 3) 'small)
    ((a b) 'letter)
    ((#\z) 'zed)
    (("s") 'string)
    (else 'other)))
(write (list (kind 2) (kind 'b) (kind #\z) (kind "s") (kind 99) (kind 'q)))
(newline)
(define (nocase x) (case x ((1) 'one)))
(write (list (nocase 1) (eq? (nocase 2) (if #f #f))))
(newline)
(define (loop n) (case (if (= n 0) 'stop 'go) ((stop) 'done) ((go) (loop (- n 1)))))
(write (loop 3000))
(newline)
(define (wl n) (when (> n 0) (wl (- n 1))))
(wl 3000)
(define (ul n) (unless (= n 0) (ul (- n 1))))
(ul 3000)
(write (case (* 2 3) ((2 3 5 7) 'prime) ((1 4 6 8 9) 'composite)))
(newline)
(define (nested x y) (case x ((1) (case y ((1) 'one-one) (else 'one-other))) (else 'other)))
(write (list (nested 1 1) (nested 1 2) (nested 2 1)))
(newline)
(write (list (and) (or) (and 1) (or 2) (and 1 2 3) (and 1 #f 3) (or #f #f 7) (or #f #f)))
(newline)
(define (count-to n) (let loop ((i 0)) (if (and (< i n) (or #f #t #f)) (loop (+ i 1)) i)))
(write (count-to 3000))
(newline)
(define (tail-and n) (and #t #t (if (= n 0) 'done (tail-and (- n 1)))))
(write (tail-and 3000))
(newline)
(define (tail-or n) (or #f (if (= n 0) 'done #f) (tail-or (- n 1))))
(write (tail-or 3000))
(newline)
(define (f x) (and (> x 0) (< x 10) (* x 2)))
(write (list (f 5) (f 20) (f -1)))
(newline)
(define (g) (and 1 (begin (display "side") 2)) 'after)
(write (g))
(newline)
