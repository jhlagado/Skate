; Standard procedures: pair mutation, equal?, character and string
; comparisons, conversions, list operations and character classes.
; Each line checks one group; the expected results are in STDPROCS.OUT.

(define p (cons 1 2))
(set-car! p 10)
(set-cdr! p '(20 30))
(write p) (newline)
(write (list (equal? (list 1 (list 2 "ab") (vector 3 4)) (list 1 (list 2 "ab") (vector 3 4)))
             (equal? '(1 2) '(1 3)) (equal? "abc" (string-copy "abc"))
             (eqv? 'a 'a) (eqv? 2 2) (equal? (vector 1 2) (vector 1 2 3)))) (newline)
(write (list (char=? #\a #\a #\a) (char<? #\a #\b #\c) (char<? #\a #\c #\b)
             (char>? #\z #\a) (char<=? #\a #\a #\b) (char>=? #\b #\c))) (newline)
(write (list (string=? "abc" "abc") (string<? "abc" "abd") (string<? "ab" "abc")
             (string>? "b" "abc") (string<=? "a" "a") (string>=? "a" "b"))) (newline)
(write (list (symbol->string 'hello) (string->symbol "world")
             (eq? (string->symbol "car") 'car))) (newline)
(write (list (number->string 0) (number->string 1234) (number->string -32768)
             (number->string 32767))) (newline)
(write (list (modulo 7 3) (modulo -7 3) (modulo 7 -3) (modulo -7 -3)
             (remainder -7 3) (abs -5) (abs 5) (abs -2.5))) (newline)
(write (list (length '()) (length '(1 2 3)) (reverse '(1 2 3)) (reverse '())
             (append) (append '(1)) (append '(1 2) '(3) '() '(4 5))
             (append '(1) 2))) (newline)
(write (list (list-tail '(1 2 3 4) 2) (list-ref '(a b c) 1)
             (memq 'c '(a b c d)) (memq 'z '(a b)) (member "b" '("a" "b" "c")))) (newline)
(write (list (assq 'b '((a 1) (b 2))) (assoc "y" '(("x" . 1) ("y" . 2)))
             (assq 'q '((a 1))) (list? '(1 2)) (list? '(1 . 2)) (list? '()))) (newline)
(write (list (char-upcase #\a) (char-downcase #\Q) (char-upcase #\1)
             (char-alphabetic? #\g) (char-alphabetic? #\5) (char-numeric? #\5)
             (char-whitespace? #\space) (char-whitespace? #\x))) (newline)
(write (list (substring "hello world" 6 11) (substring "abc" 1 1) (substring "abc" 0 3))) (newline)
(define (build n acc) (if (= n 0) acc (build (- n 1) (cons n acc))))
(define big (build 400 '()))
(write (length (append big big))) (newline)
(write (car (reverse (append big (list 99))))) (newline)
